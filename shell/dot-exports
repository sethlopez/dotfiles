#==============================================================================#
# environment                                                                  #
#                                                                              #
# POSIX sh, so bash and zsh can both source it                                 #
# zsh sources this from ~/.zprofile                                            #
#==============================================================================#

#-- Homebrew -------------------------------------------------------------------

if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

#-- Path -----------------------------------------------------------------------

# add mise shims
export PATH="$HOME/.local/share/mise/shims:$PATH"
# add ~/bin
export PATH="$HOME/bin:$PATH"
# add ~/.local/bin
export PATH="$HOME/.local/bin:$PATH"
# add ~/.cargo/bin
export PATH="$HOME/.cargo/bin:$PATH"

#-- Android --------------------------------------------------------------------

# ANDROID_HOME is the current variable; ANDROID_SDK_ROOT is deprecated
# see: https://developer.android.com/tools/variables
export ANDROID_HOME="$HOME/Library/Android/sdk"
# adb lives in platform-tools, and the avd aliases need emulator
export PATH="$PATH:$ANDROID_HOME/platform-tools"
export PATH="$PATH:$ANDROID_HOME/emulator"

#-- SSH ------------------------------------------------------------------------

# use 1Password's ssh agent when available
_op_agent_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [ -S "$_op_agent_sock" ]; then
    export SSH_AUTH_SOCK="$_op_agent_sock"
fi
unset _op_agent_sock

#-- Editor ---------------------------------------------------------------------

if command -v "nvim" > /dev/null 2>&1; then
    export EDITOR=nvim
    export VISUAL=nvim
else
    export EDITOR=vim
    export VISUAL=vim
fi
